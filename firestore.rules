rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.keys().hasOnly(['schemaVersion', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.schemaVersion == 1
        && (data.email == null || data.email is string)
        && (data.displayName == null || data.displayName is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validAppearance(data) {
      return data.keys().hasOnly(['schemaVersion', 'theme'])
        && data.schemaVersion == 1
        && (data.theme == 'dark' || data.theme == 'light');
    }

    function validLauncher(data) {
      return data.keys().hasOnly(['schemaVersion', 'selectedItemIds'])
        && data.schemaVersion == 1
        && data.selectedItemIds is list
        && data.selectedItemIds.size() <= 10;
    }

    function validPreferences(data) {
      return data.keys().hasOnly(['schemaVersion']) && data.schemaVersion == 1;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validProfile(request.resource.data);
      allow update: if owns(uid)
        && validProfile(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /config/{configName} {
        allow read: if owns(uid) && configName in ['appearance', 'launcher', 'preferences'];
        allow create, update: if owns(uid) && (
          (configName == 'appearance' && validAppearance(request.resource.data)) ||
          (configName == 'launcher' && validLauncher(request.resource.data)) ||
          (configName == 'preferences' && validPreferences(request.resource.data))
        );
        allow delete: if owns(uid) && configName in ['appearance', 'launcher', 'preferences'];
      }
    }
  }
}
