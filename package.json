{
  "name": "tornado-app-launcher",
  "productName": "Tornado",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "main": "electron/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "desktop:dev": "node electron/scripts/dev.mjs",
    "desktop:build": "npm run build && npx --yes electron-builder@26.15.3 --win --x64 --config electron-builder.yml --publish never",
    "desktop:dir": "npm run build && npx --yes electron-builder@26.15.3 --dir --config electron-builder.yml",
    "desktop:test": "node --test tests/platform-foundation.test.mjs tests/electron-security.test.mjs tests/phase-7-desktop-lifecycle.test.mjs",
    "lint": "eslint .",
    "test": "playwright test",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.5.2",
    "@capacitor/browser": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@vitejs/plugin-react": "latest",
    "firebase": "11.10.0",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@eslint/js": "latest",
    "@playwright/test": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest"
  }
}
